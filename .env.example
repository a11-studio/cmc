# Public — safe for the browser. Never put secret keys in NEXT_PUBLIC_* variables.
# Canonical URL for Open Graph / Twitter cards (e.g. https://thearena.buzz). Falls back to VERCEL_URL locally.
NEXT_PUBLIC_SITE_URL=
# When true, homepage and /agents use lightweight Supabase reads (no 48-cycle hydrate per agent).
ARENA_DASHBOARD_LITE=
# Persistence + Realtime also need the SQL in supabase/migrations/20260917120000_arena.sql
# applied in the Supabase SQL editor. The app still runs without these keys (in-memory store).
NEXT_PUBLIC_SUPABASE_URL=
# Use the anon / publishable key from Supabase → Project Settings → API (browser-safe).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=  # optional alias (Supabase quickstart name)

# Server-only — used by API routes, server components, and future engines.
# Do not expose these to the client. Never use NEXT_PUBLIC_GEMINI_API_KEY.
# Server Supabase key: legacy name or Supabase quickstart `sb_secret_…` alias.
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEY=
# For scripts/apply-supabase-migrations.mjs — paste Session pooler URI from Database → Connect,
# or set SUPABASE_DB_PASSWORD + optional SUPABASE_POOLER_REGION (default eu-west-2).
# SUPABASE_DATABASE_URL=
# SUPABASE_DB_PASSWORD=
# One-time history copy (scripts/copy-supabase-history.mjs) from the old project:
# SUPABASE_SOURCE_URL=
# SUPABASE_SOURCE_SECRET_KEY=
CMC_API_KEY=
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.1-flash-lite if empty. Prefer Lite models — full Flash is often capacity-constrained.
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional comma-separated fallbacks used when the primary model is overloaded.
# Leave unset to use the built-in Lite fallbacks.
GEMINI_FALLBACK_MODELS=
